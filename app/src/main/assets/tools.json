[
  {
    "name": "set_led",
    "description": "Light the onboard RGB LED",
    "parameters": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "description": "color for solid or flash; omit for off",
          "enum": ["red", "green", "blue", "yellow", "purple", "white"]
        },
        "mode": {
          "type": "string",
          "description": "solid, flash, or off; use off to turn light off",
          "enum": ["solid", "flash", "off"]
        },
        "duration_seconds": {
          "type": "number",
          "maximum": 30
        }
      },
      "required": ["mode"]
    }
  },
  {
    "name": "get_weather",
    "description": "Get weather; use here for the current location",
    "parameters": {
      "type": "object",
      "properties": {
        "location": {
          "type": "string",
          "description": "city or place; here is a valid current location"
        }
      }
    }
  },
  {
    "name": "get_time",
    "description": "Get clock time; use here for the current location",
    "parameters": {
      "type": "object",
      "properties": {
        "location": {
          "type": "string",
          "description": "city or place; here is a valid current location"
        }
      }
    }
  },
  {
    "name": "set_brightness",
    "description": "Change only the Agave screen brightness",
    "parameters": {
      "type": "object",
      "properties": {
        "brightness_percent": {
          "type": "number",
          "description": "screen brightness from 0 to 100",
          "maximum": 100
        }
      },
      "required": ["brightness_percent"]
    }
  },
  {
    "name": "set_volume",
    "description": "Change Android media audio volume",
    "parameters": {
      "type": "object",
      "properties": {
        "volume_percent": {
          "type": "number",
          "description": "audio volume from 0 to 100",
          "maximum": 100
        }
      },
      "required": ["volume_percent"]
    }
  }
]
