{
  "schema_version": 1,
  "id": "create_calendar_event",
  "version": 1,
  "order": 310,
  "enabled": true,
  "tool": {
    "name": "create_calendar_event",
    "description": "Create an event in the Android calendar",
    "parameters": {
      "type": "object",
